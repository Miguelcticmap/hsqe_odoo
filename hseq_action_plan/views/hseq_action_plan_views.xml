<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hseq_action_plan_view_list" model="ir.ui.view">
        <field name="name">hseq.action.plan.list</field>
        <field name="model">hseq.action.plan</field>
        <field name="arch" type="xml">
            <list string="Planes de Acción" decoration-danger="is_overdue" decoration-success="state == 'closed'">
                <field name="name"/>
                <field name="description"/>
                <field name="action_type"/>
                <field name="origin" optional="show"/>
                <field name="site_id"/>
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <field name="date_deadline"/>
                <field name="progress" widget="progressbar"/>
                <field name="priority" optional="hide"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'in_progress'"
                       decoration-warning="state == 'done'"
                       decoration-success="state in ('verified', 'closed')"/>
            </list>
        </field>
    </record>

    <record id="hseq_action_plan_view_form" model="ir.ui.view">
        <field name="name">hseq.action.plan.form</field>
        <field name="model">hseq.action.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de Acción">
                <header>
                    <button name="action_start" string="Iniciar" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Marcar ejecutada" type="object"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_verify" string="Verificar" type="object"
                            class="btn-primary" invisible="state != 'done'"
                            groups="hseq_core.group_hseq_supervisor"/>
                    <button name="action_close" string="Cerrar" type="object"
                            class="btn-primary" invisible="state != 'verified'"
                            groups="hseq_core.group_hseq_supervisor"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('closed', 'cancelled')"/>
                    <button name="action_reset_draft" string="Volver a borrador" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done,verified,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="description" placeholder="Descripción corta de la acción"/></h2>
                    </div>
                    <group>
                        <group string="Clasificación">
                            <field name="action_type"/>
                            <field name="origin"/>
                            <field name="origin_reference"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Ubicación">
                            <field name="site_id"/>
                            <field name="area_id"/>
                            <field name="process_id"/>
                        </group>
                        <group string="Responsables">
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                            <field name="verifier_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Fechas y seguimiento">
                            <field name="date_start"/>
                            <field name="date_deadline"/>
                            <field name="date_closed"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle" name="detail">
                            <field name="detail" placeholder="Descripción detallada de la acción..."/>
                        </page>
                        <page string="Eficacia" name="effectiveness">
                            <group>
                                <field name="effectiveness"/>
                                <field name="effectiveness_notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hseq_action_plan_view_search" model="ir.ui.view">
        <field name="name">hseq.action.plan.search</field>
        <field name="model">hseq.action.plan</field>
        <field name="arch" type="xml">
            <search string="Planes de Acción">
                <field name="name"/>
                <field name="description"/>
                <field name="responsible_id"/>
                <field name="site_id"/>
                <filter string="Mis acciones" name="my_actions"
                        domain="[('responsible_id', '=', uid)]"/>
                <filter string="Vencidas" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Abiertas" name="open"
                        domain="[('state', 'in', ('draft', 'in_progress', 'done'))]"/>
                <separator/>
                <filter string="Fecha compromiso" name="filter_deadline" date="date_deadline"/>
                <separator/>
                <group>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Sede" name="group_site" context="{'group_by': 'site_id'}"/>
                    <filter string="Origen" name="group_origin" context="{'group_by': 'origin'}"/>
                    <filter string="Responsable" name="group_responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hseq_action_plan_action" model="ir.actions.act_window">
        <field name="name">Planes de Acción</field>
        <field name="res_model">hseq.action.plan</field>
        <field name="view_mode">list,form,calendar,pivot</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <record id="hseq_action_plan_view_calendar" model="ir.ui.view">
        <field name="name">hseq.action.plan.calendar</field>
        <field name="model">hseq.action.plan</field>
        <field name="arch" type="xml">
            <calendar string="Planes de Acción" date_start="date_deadline" color="responsible_id">
                <field name="description"/>
                <field name="site_id"/>
            </calendar>
        </field>
    </record>

    <record id="hseq_action_plan_view_pivot" model="ir.ui.view">
        <field name="name">hseq.action.plan.pivot</field>
        <field name="model">hseq.action.plan</field>
        <field name="arch" type="xml">
            <pivot string="Planes de Acción">
                <field name="site_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <menuitem id="menu_hseq_action_plan" name="Planes de Acción"
              parent="hseq_core.menu_hseq_actions"
              action="hseq_action_plan_action" sequence="10"/>
</odoo>
