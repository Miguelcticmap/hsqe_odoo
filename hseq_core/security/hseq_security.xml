<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hseq" model="ir.module.category">
        <field name="name">HSEQ</field>
        <field name="description">Sistema de Gestión HSEQ MAPEI Colombia</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_hseq" model="res.groups.privilege">
        <field name="name">HSEQ</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_hseq"/>
    </record>

    <record id="group_hseq_user" model="res.groups">
        <field name="name">HSEQ Usuario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_hseq"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Consulta información permitida, crea reportes e incidentes y ejecuta actividades asignadas.</field>
    </record>

    <record id="group_hseq_responsible" model="res.groups">
        <field name="name">HSEQ Responsable</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_hseq"/>
        <field name="implied_ids" eval="[(4, ref('group_hseq_user'))]"/>
        <field name="comment">Gestiona registros, acciones, inspecciones y capacitaciones.</field>
    </record>

    <record id="group_hseq_auditor" model="res.groups">
        <field name="name">HSEQ Auditor</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="privilege_hseq"/>
        <field name="implied_ids" eval="[(4, ref('group_hseq_user'))]"/>
        <field name="comment">Ejecuta auditorías, registra hallazgos, revisa evidencias y emite informes.</field>
    </record>

    <record id="group_hseq_supervisor" model="res.groups">
        <field name="name">HSEQ Supervisor</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="privilege_hseq"/>
        <field name="implied_ids" eval="[(4, ref('group_hseq_responsible')), (4, ref('group_hseq_auditor'))]"/>
        <field name="comment">Revisa, aprueba, cierra registros y consulta indicadores.</field>
    </record>

    <record id="group_hseq_manager" model="res.groups">
        <field name="name">HSEQ Administrador</field>
        <field name="sequence">50</field>
        <field name="privilege_id" ref="privilege_hseq"/>
        <field name="implied_ids" eval="[(4, ref('group_hseq_supervisor'))]"/>
        <field name="comment">Acceso completo a la configuración del sistema HSEQ.</field>
    </record>
</odoo>
